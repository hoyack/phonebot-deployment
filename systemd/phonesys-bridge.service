[Unit]
Description=FreePBX ARI to Hermes Phone Bridge
After=network-online.target hermes-phonebot.service
Wants=network-online.target
Requires=hermes-phonebot.service

[Service]
Type=simple
EnvironmentFile=%h/.config/phonebot/phonebot.env
WorkingDirectory=%h/phonebot-deployment/phonesys
ExecStart=%h/phonebot-deployment/phonesys/.venv/bin/python -m phonesys.main
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
