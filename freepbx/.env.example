# Optional local overrides: copy to freepbx/.env (ignored), edit before first up.
# Paths resolve from freepbx/; absolute paths may include spaces.
PHONESYS_DIR=../phonesys
PBX_ADMIN_BIND=127.0.0.1
# Change all four together if this subnet overlaps LAN, VPN, WSL or Docker.
PBX_SUBNET=10.77.0.0/24
PBX_GATEWAY=10.77.0.1
PBX_DB_IP=10.77.0.10
PBX_IP=10.77.0.20
